      ],
      "duration_ms": 3302,
      "latency_ms": 3687,
      "retrieval_top_score": 0.0,
      "retrieved_chunk_ids": [
        "7c78dbb7-cc8c-5f78-af46-22d35fedcef3",
        "7d059411-5848-52c0-8f3a-4c308c994fe2",
        "e6f8978e-01eb-5700-ba1b-cd966468b3e1",
