# ---- 密钥与本地环境（绝不入库）----
# 注意：`.env` 只匹配精确文件名，`.env.prod` / `.env.dev` 这类不会被匹配，
# 必须用通配形式覆盖，否则将来新增的环境文件会被静默提交。
.env
deploy/.env
*.env.local
*.env.*.local

# 覆盖所有 .env 变体（.env.prod / .env.dev / .env.bak / .env.production ...）
.env.*
*/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# 账户凭据类
.git-credentials
*.pem
*.key
*.p12
id_rsa*
.npmrc
.pypirc

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ---- Node / 前端 ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Go ----
# 可执行产物
/backend/ai-service
/backend/api
*.exe
*.test
*.out

# ---- 构建与运行产物 ----
dist/
build/
*.log
tmp/
.cache/

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 智能体工作区（内部笔记，不属于项目交付物）----
.workbuddy/
