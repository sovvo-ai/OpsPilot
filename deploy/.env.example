# OpsPilot 环境变量模板
# 用法：cp deploy/.env.example deploy/.env，然后填入真实值
# 注意：deploy/.env 已在 .gitignore 中，永远不会被提交

# ---------- 运行环境 ----------
APP_ENV=dev
# dev 环境下才启用 dev-token 接口；生产必须为 false
ENABLE_DEV_AUTH=true
APP_PORT=8081
AI_PORT=8000

# ---------- 数据库 ----------
# 宿主端口用 55432（5432 已被本机 pg-local 占用）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ops_pilot
POSTGRES_USER=ops_pilot
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://ops_pilot:change-me-local-only@postgres:5432/ops_pilot?sslmode=disable

# ---------- 阿里云百炼（LLM + Embedding）----------
# 从百炼控制台获取；只写在 deploy/.env，不写进代码/日志/测试输出
DASHSCOPE_API_KEY=<FILL_ME>
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ROUTER=qwen-flash
LLM_MODEL_QA=qwen-plus
LLM_MODEL_TROUBLESHOOT=qwen-plus
LLM_MODEL_CHECKER=qwen-plus
LLM_MODEL_FINAL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ---------- 鉴权 ----------
# 用户 JWT 签名密钥（≥32 字节随机串）
JWT_SECRET=<FILL_ME>
# Go → Python 内部调用令牌（≥32 字节随机串；两侧必须一致）
AI_SERVICE_TOKEN=<FILL_ME>

# ---------- 摄取与一致性 ----------
INGEST_READ_TIMEOUT_SECONDS=120
INGEST_CONNECT_TIMEOUT_SECONDS=3
WATCHDOG_INTERVAL_SECONDS=60
WATCHDOG_BATCH_SIZE=50
PENDING_TIMEOUT_SECONDS=120
PROCESSING_TIMEOUT_SECONDS=150
DELETING_RETRY_SECONDS=60
ORPHAN_CHUNK_TTL_SECONDS=600
EMBEDDING_BATCH_SIZE=10

# ---------- 检索 ----------
HNSW_EF_SEARCH=100
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# ---------- 日志 ----------
LOG_LEVEL=info
